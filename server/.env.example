# SMTP Server Configuration# Copy this file to .env and fill in the values

SMTP_HOST=smtp.gmail.com# SMTP settings (for Gmail use smtp.gmail.com and an app password)

SMTP_PORT=465SMTP_HOST=smtp.gmail.com

SMTP_SECURE=trueSMTP_PORT=465

SMTP_SECURE=true

# Email Authentication (for Gmail, use App Password)SMTP_USER=youremail@gmail.com

SMTP_USER=your.email@gmail.comSMTP_PASS=your_smtp_password_or_app_password

SMTP_PASS=your_app_password_here

# Where feedback emails will be delivered

# Recipient Email AddressFEEDBACK_TO=artappreciating@gmail.com

FEEDBACK_TO=artappreciating@gmail.com

# Server port

# Server ConfigurationPORT=3001

PORT=3001
CORS_ORIGIN=http://localhost:5500  # Update this to match your frontend URL